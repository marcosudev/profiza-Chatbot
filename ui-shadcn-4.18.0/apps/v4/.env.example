# ============================================================
# Profiza Painel Web (Next.js) — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com as credenciais do Supabase
# ============================================================

# Supabase URL (Painel Supabase > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Supabase Anon Key (Painel Supabase > Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase Service Role Key (Apenas server-side)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
