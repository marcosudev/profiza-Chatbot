# ============================================================
# Profiza Bot — variáveis de ambiente
# Copie para .env e preencha os valores reais
# ============================================================

# Supabase — use a SERVICE ROLE KEY (bypassa RLS, só no servidor)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI
OPENAI_API_KEY=sk-...

# Evolution API — configure no painel da sua instância
EVOLUTION_BASE_URL=https://seu-servidor.com
EVOLUTION_INSTANCE=nome-da-instancia
EVOLUTION_API_KEY=sua-api-key

# Servidor
PORT=3001

# Segurança — token secreto que você configura no webhook do Evolution API
WEBHOOK_SECRET=profiza-webhook-secret-2024
