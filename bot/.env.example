# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
EVOLUTION_BASE_URL=https://sua-evolution-api.up.railway.app
EVOLUTION_INSTANCE=profiza
EVOLUTION_API_KEY=sua-api-key

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=uma-senha-forte-aqui

# ── Telegram (central de atendimento humano — RF-15) ─────────────────────────
# 1. Crie um bot em @BotFather e copie o token
# 2. Crie um grupo privado, adicione o bot e copie o ID (use @userinfobot)
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_GROUP_ID=-1001234567890

# ── Mercado Pago (assinaturas — RF-13) ────────────────────────────────────────
# Access token da sua conta MP (Credenciais > Access Token)
MP_ACCESS_TOKEN=APP_USR-...

# ── Configurações do bot (opcionais — têm padrão) ────────────────────────────
BUFFER_TIMEOUT_MS=8000
BUFFER_MAX_TIMEOUT_MS=60000
SESSION_TIMEOUT_MS=1800000
MAX_PROFISSIONAIS=4
LLM_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=whisper-1
AUDIO_MAX_SECONDS=120
FEEDBACK_DELAY_HOURS=24
PORT=3001
