# ============================================================
# Profiza Bot — variáveis de ambiente
# Copie para .env e preencha os valores reais
# ============================================================

# Supabase — use a SERVICE ROLE KEY (bypassa RLS, só no servidor)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI
OPENAI_API_KEY=sk-...

# Z-API — encontre no painel em app.z-api.io
ZAPI_INSTANCE_ID=SEU_INSTANCE_ID
ZAPI_TOKEN=SEU_TOKEN
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN

# Servidor
PORT=3001

# Segurança — token secreto que você configura no webhook da Z-API
WEBHOOK_SECRET=profiza-webhook-secret-2024
